{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# hash: {{ include "../src/claude-usage.ts" | sha256sum }}
set -euo pipefail

# The source lives outside the chezmoi root so only the binary is deployed, and
# it imports chalk, which resolves only against the repo's own node_modules.
REPO="{{ .chezmoi.sourceDir }}/.."
SRC="$REPO/src/claude-usage.ts"
OUT="{{ .chezmoi.homeDir }}/.local/bin/claude-usage"

if ! command -v bun &>/dev/null; then
  echo "[compile-claude-usage] bun not found, skipping compilation"
  exit 0
fi

echo "[compile-claude-usage] Installing repo dependencies"
bun install --cwd "$REPO" --frozen-lockfile

# --compile already implies --production (minify + NODE_ENV=production);
# --bytecode trades ~200KB of binary size for faster interpreter startup.
echo "[compile-claude-usage] Compiling claude-usage.ts → binary"
bun build --compile --bytecode "$SRC" --outfile "$OUT"
chmod +x "$OUT"
echo "[compile-claude-usage] Done"
{{ end -}}
