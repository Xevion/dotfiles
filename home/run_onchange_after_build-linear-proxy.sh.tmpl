{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Builds linear-proxy into ~/.local/bin. The crate lives in its own repo at
# ~/projects/linear-local (a local path, not part of this source directory). The
# hash below is the crate's source digest at render time, so this re-runs when it
# changes; a missing checkout or toolchain skips the build and leaves the
# existing binary in place. The service script that follows restarts the daemon.
# hash: {{ output "sh" "-c" (print "cat " .chezmoi.homeDir "/projects/linear-local/src/*.rs " .chezmoi.homeDir "/projects/linear-local/Cargo.toml " .chezmoi.homeDir "/projects/linear-local/Cargo.lock 2>/dev/null | sha256sum || true") }}
set -euo pipefail

CRATE="{{ .chezmoi.homeDir }}/projects/linear-local"
OUT="{{ .chezmoi.homeDir }}/.local/bin/linear-proxy"

if ! command -v cargo >/dev/null 2>&1; then
  echo "[build-linear-proxy] cargo not found, skipping (existing binary kept)"
  exit 0
fi
if [[ ! -f "$CRATE/Cargo.toml" ]]; then
  echo "[build-linear-proxy] crate not found at $CRATE; skipping"
  exit 0
fi

echo "[build-linear-proxy] Building linear-proxy (release)"
cargo build --release --locked --quiet --manifest-path "$CRATE/Cargo.toml"
# Install beside the target and rename, so a running daemon keeps its old inode.
install -Dm755 "$CRATE/target/release/linear-proxy" "$OUT.new"
mv -f "$OUT.new" "$OUT"
echo "[build-linear-proxy] Installed -> $OUT"
{{ end -}}
