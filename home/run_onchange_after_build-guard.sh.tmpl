{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Builds the `guard` Claude Code hook into ~/.claude/hooks/guard. The crate
# lives in its own repo at ~/projects/guard, so this is a convenience: `just
# install` there does the same thing. The hash below is the source digest at
# render time, so this re-runs when the crate changes; a missing repo or
# toolchain skips the build and leaves the existing hook in place.
# hash: {{ output "sh" "-c" (print "cat " .chezmoi.homeDir "/projects/guard/src/*.rs " .chezmoi.homeDir "/projects/guard/Cargo.toml 2>/dev/null | sha256sum || true") }}
set -euo pipefail

CRATE="{{ .chezmoi.homeDir }}/projects/guard"
OUT="{{ .chezmoi.homeDir }}/.claude/hooks/guard"

if ! command -v cargo >/dev/null 2>&1; then
  echo "[build-guard] cargo not found, skipping (existing hook kept)"
  exit 0
fi
if [[ ! -d "$CRATE" ]]; then
  echo "[build-guard] crate not cloned at $CRATE; skipping"
  exit 0
fi

echo "[build-guard] Building guard (release)"
cargo build --release --manifest-path "$CRATE/Cargo.toml" --quiet
install -Dm755 "$CRATE/target/release/guard" "$OUT"
echo "[build-guard] Installed -> $OUT"
{{ end -}}
