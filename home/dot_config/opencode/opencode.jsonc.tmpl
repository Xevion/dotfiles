{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-5-5",
  "providers": {
    "anthropic": {
      "settings": {
        "baseURL": "http://127.0.0.1:3456/v1",
        "apiKey": "{{ dopplerProjectJson.DARIO_API_KEY }}",
      },
      "models": {
        "claude-haiku-4-5": { "disabled": true },
        "claude-haiku-4-5-20251001": { "disabled": true },
        "claude-sonnet-4-5": { "disabled": true },
        "claude-sonnet-4-5-20250929": { "disabled": true },
        "claude-sonnet-4-6": { "disabled": true },
        "claude-opus-4-5": { "disabled": true },
        "claude-opus-4-5-20251101": { "disabled": true },
        "claude-opus-4-6": { "disabled": true },
        "claude-opus-4-7": { "disabled": true },
        "claude-opus-4-8": { "disabled": true },
        "claude-opus-4-8-fast": { "disabled": true },
      },
    },
  },
  "skills": ["{{ .chezmoi.homeDir }}/.claude/skills"],
  "agent": {
    "explore": {
      "disable": true,
    },
  },
  "keybinds": {
    "model_cycle_favorite": "ctrl+f",
  },
  "lsp": {
    "typescript": { "disabled": true },
    "rust": { "disabled": true },
    "gopls": { "disabled": true },
    "pyright": { "disabled": true },
    "jdtls": { "disabled": true },
    "svelte": { "disabled": true },
    "eslint": { "disabled": true },
  },
  "permission": {
    // Bash permissions generated from meta/permissions.ts
    "bash": {{ output "bun" (joinPath .chezmoi.sourceDir "../meta/permissions.ts") "opencode" }},

    // -- External directory access --
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "/home/xevion/projects/**": "allow",
      "/home/xevion/.cargo/registry/**": "allow",
      "/home/xevion/.local/bin/**": "allow",
      "/home/xevion/.local/share/fonts/**": "allow",
      "/home/xevion/.local/share/opencode/**": "allow",
      "/home/xevion/.local/share/chezmoi/**": "allow",
      "/home/xevion/.config/opencode/**": "allow",
      "/home/xevion/.config/Claude/**": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
    },

    // -- Web / search --
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",

    // -- MCP servers --
    "context7_*": "allow",
    "exa_*": "allow",
    "gh_grep_*": "allow",
    "linear_*": "allow",

    // -- Safety --
    "doom_loop": "ask",
  },
  "mcp": {{ output "bun" (joinPath .chezmoi.sourceDir "../meta/mcp-servers.ts") "opencode" dopplerProjectJson.CONTEXT7_API_KEY dopplerProjectJson.EXA_API_KEY }},
}
